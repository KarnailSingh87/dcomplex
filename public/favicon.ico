<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="dcBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f382a"/>
      <stop offset="100%" stop-color="#062319"/>
    </linearGradient>
    <linearGradient id="goldAccent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24"/>
      <stop offset="100%" stop-color="#d97706"/>
    </linearGradient>
  </defs>
  <!-- Background Squircle -->
  <rect width="64" height="64" rx="16" fill="url(#dcBg)"/>
  <rect x="1" y="1" width="62" height="62" rx="15" fill="none" stroke="#34d399" stroke-opacity="0.3" stroke-width="1.5"/>
  <!-- DC Monogram -->
  <text x="32" y="43" font-family="-apple-system, BlinkMacSystemFont, 'Plus Jakarta Sans', 'Inter', sans-serif" font-weight="900" font-size="29" fill="#ffffff" text-anchor="middle" letter-spacing="-1">DC</text>
  <!-- Golden Pin Accent Dot -->
  <circle cx="50" cy="18" r="4" fill="url(#goldAccent)"/>
</svg>
